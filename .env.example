# MongoDB connection string.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=

# Database name inside the cluster. Defaults to "smartshop" when omitted.
MONGODB_DB=smartshop

# Secret used to sign session cookies. At least 16 characters; required in
# production. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Order confirmation emails. Works with any SMTP provider.
#   Gmail:  host smtp.gmail.com, port 587, user your@gmail.com,
#           pass = a 16-character App Password (not your normal password)
#   Resend: host smtp.resend.com, port 587, user "resend", pass = your API key
# Leave blank and the app skips sending, logging a warning instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartShop <orders@yourdomain.com>

# Where new-order notifications go (the shop owner).
OWNER_EMAIL=

# Where customer replies go. Falls back to OWNER_EMAIL.
REPLY_TO_EMAIL=

# Cloudinary, for product images and videos. In local development uploads can
# fall back to public/uploads when these are blank. Production uploads fail
# until persistent storage is configured.
# Either paste the single URL the dashboard shows:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# or set the three separately. The URL wins if both are present.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public address of the site, used for the links in password-reset emails.
# On Vercel this is detected automatically; set it once you have a real domain.
#   NEXT_PUBLIC_SITE_URL=https://smartshop.pk
NEXT_PUBLIC_SITE_URL=

# Google Gemini AI shopping assistant (server-side only).
# Create/rotate a key at https://aistudio.google.com/apikey.
# Never use a NEXT_PUBLIC_ prefix for this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
