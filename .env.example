# MongoDB connection string.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local: mongodb://127.0.0.1:27017
MONGODB_URI=

# Database name inside the cluster. Defaults to "smartshop" when omitted.
MONGODB_DB=smartshop

# Secret used to sign session cookies. At least 16 characters; required in
# production. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Order confirmation emails. Works with any SMTP provider.
#   Gmail:  host smtp.gmail.com, port 587, user your@gmail.com,
#           pass = a 16-character App Password (not your normal password)
#   Resend: host smtp.resend.com, port 587, user "resend", pass = your API key
# Leave blank and the app skips sending, logging a warning instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartShop <orders@yourdomain.com>

# Where new-order notifications go (the shop owner).
OWNER_EMAIL=

# Where customer replies go. Falls back to OWNER_EMAIL.
REPLY_TO_EMAIL=
